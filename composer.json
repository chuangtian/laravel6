{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2",
        "almasaeed2010/adminlte": "~3.0",
        "dianwoung/large-file-upload": "^0.0.3",
        "encore/laravel-admin": "^1.7",
        "fideloper/proxy": "^4.0",
        "ichynul/configx": "^1.3",
        "jxlwqq/code-mirror": "^1.0",
        "jxlwqq/composer-viewer": "^1.0",
        "jxlwqq/env-manager": "^0.1.0",
        "jxlwqq/material-ui": "^1.0",
        "laravel-admin-ext/backup": "^1.1",
        "laravel-admin-ext/config": "^1.1",
        "laravel-admin-ext/cropper": "^1.0",
        "laravel-admin-ext/file-browser": "^0.0.2",
        "laravel-admin-ext/helpers": "^1.2",
        "laravel-admin-ext/lock-screen": "^1.0",
        "laravel-admin-ext/log-viewer": "^1.0",
        "laravel-admin-ext/media-player": "^1.1",
        "laravel-admin-ext/phpinfo": "^1.0",
        "laravel-admin-ext/scheduling": "^1.1",
        "laravel-admin-extensions/multi-language": "^0.0.6",
        "laravel/framework": "^6.0",
        "laravel/tinker": "^1.0",
        "laravel/ui": "^1.1",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "~4.0",
        "xiewenfeng/lodpod-editor": "^0.0.1"
    },
    "require-dev": {
        "facade/ignition": "^1.4",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^8.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://packagist.phpcomposer.com"
        }
    }
}
